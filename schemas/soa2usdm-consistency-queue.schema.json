{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kerfors.github.io/soa2usdm/schemas/soa2usdm-consistency-queue.json",
  "title": "SoA2USDM cross-study consistency queue (all collections)",
  "description": "Mechanical review queue: a normalised phrase met in two or more studies whose items do not all have the same routing outcome (routed + domain; open or weak + candidate domains; not routed; no own row). Grain and finding kind are carried, not compared. Also: phrases with different outcomes inside one study, and flags kept by hand (collections/consistency_flags.json). Decides nothing. Generated by soa2usdm.consistency from the published grain, grain decisions and routing files. 1.1: review results from collections/consistency_review.json (kept by hand) attached to their entries, entries whose outcomes changed since review marked, reviewed subjects no longer present listed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "check_version",
    "generated_at",
    "inputs",
    "counts",
    "queue",
    "within_study",
    "flags"
  ],
  "definitions": {
    "outcome": {
      "type": "object",
      "required": [
        "status",
        "domain",
        "candidates"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "routed",
            "open",
            "weak",
            "not routed",
            "no own row"
          ]
        },
        "domain": {
          "type": [
            "string",
            "null"
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "routed"
              }
            }
          },
          "then": {
            "properties": {
              "domain": {
                "type": "string"
              },
              "candidates": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "domain": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "not routed",
                  "no own row"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "candidates": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "split": {
      "type": "object",
      "required": [
        "standalone",
        "member"
      ],
      "additionalProperties": false,
      "properties": {
        "standalone": {
          "type": "integer",
          "minimum": 0
        },
        "member": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collection",
        "protocol_id",
        "unit",
        "phrase",
        "activity_name",
        "xact_id",
        "member_id",
        "panel_name",
        "members_from",
        "grain",
        "grain_source",
        "prompt_version",
        "route_source",
        "reach",
        "outcome"
      ],
      "properties": {
        "collection": {
          "type": "string"
        },
        "protocol_id": {
          "type": "string"
        },
        "unit": {
          "enum": [
            "standalone",
            "member"
          ]
        },
        "phrase": {
          "type": "string",
          "minLength": 1
        },
        "activity_name": {
          "type": "string"
        },
        "xact_id": {
          "type": "string"
        },
        "member_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "panel_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "members_from": {
          "enum": [
            null,
            "label",
            "protocol context"
          ]
        },
        "grain": {
          "type": "string"
        },
        "grain_source": {
          "type": "string"
        },
        "prompt_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "route_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "reach": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why the item has no routing row of its own: the routing not_reached reason, or 'grain <grain>'."
        },
        "outcome": {
          "$ref": "#/definitions/outcome"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "unit": {
                "const": "member"
              }
            }
          },
          "then": {
            "properties": {
              "member_id": {
                "type": "string"
              },
              "panel_name": {
                "type": "string"
              },
              "members_from": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "member_id": {
                "type": "null"
              },
              "panel_name": {
                "type": "null"
              },
              "members_from": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "group": {
      "type": "object",
      "required": [
        "phrase",
        "studies",
        "items_count",
        "outcomes",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "phrase": {
          "type": "string",
          "minLength": 1
        },
        "items_count": {
          "$ref": "#/definitions/split"
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "outcome",
              "studies",
              "items"
            ],
            "additionalProperties": false,
            "properties": {
              "outcome": {
                "$ref": "#/definitions/outcome"
              },
              "studies": {
                "type": "integer",
                "minimum": 1
              },
              "items": {
                "$ref": "#/definitions/split"
              }
            }
          }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/item"
          }
        },
        "studies": {
          "type": "integer",
          "minimum": 1
        },
        "review": {
          "$ref": "#/definitions/review"
        }
      }
    },
    "queue_group": {
      "type": "object",
      "required": [
        "phrase",
        "studies",
        "items_count",
        "outcomes",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "phrase": {
          "type": "string",
          "minLength": 1
        },
        "items_count": {
          "$ref": "#/definitions/split"
        },
        "outcomes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "outcome",
              "studies",
              "items"
            ],
            "additionalProperties": false,
            "properties": {
              "outcome": {
                "$ref": "#/definitions/outcome"
              },
              "studies": {
                "type": "integer",
                "minimum": 1
              },
              "items": {
                "$ref": "#/definitions/split"
              }
            }
          }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/item"
          }
        },
        "studies": {
          "type": "integer",
          "minimum": 2
        },
        "review": {
          "$ref": "#/definitions/review"
        }
      }
    },
    "within": {
      "type": "object",
      "required": [
        "collection",
        "protocol_id",
        "phrase",
        "items_count",
        "outcomes",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "phrase": {
          "type": "string",
          "minLength": 1
        },
        "items_count": {
          "$ref": "#/definitions/split"
        },
        "outcomes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "outcome",
              "studies",
              "items"
            ],
            "additionalProperties": false,
            "properties": {
              "outcome": {
                "$ref": "#/definitions/outcome"
              },
              "studies": {
                "type": "integer",
                "minimum": 1
              },
              "items": {
                "$ref": "#/definitions/split"
              }
            }
          }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/item"
          }
        },
        "collection": {
          "type": "string"
        },
        "protocol_id": {
          "type": "string"
        },
        "review": {
          "$ref": "#/definitions/review"
        }
      }
    },
    "study": {
      "type": "object",
      "required": [
        "collection",
        "protocol_id"
      ],
      "additionalProperties": false,
      "properties": {
        "collection": {
          "type": "string"
        },
        "protocol_id": {
          "type": "string"
        }
      }
    },
    "review": {
      "type": "object",
      "description": "1.1: the review of this entry.",
      "additionalProperties": false,
      "required": [
        "result",
        "note",
        "goes_to",
        "reviewed_on",
        "outcomes_seen",
        "changed_since_review"
      ],
      "properties": {
        "result": {
          "enum": [
            "accept",
            "knowledge",
            "AI decision to redo",
            "matching fix",
            "routing mechanism",
            "context member list"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "goes_to": {
          "enum": [
            null,
            "step 4",
            "step 5",
            "4d"
          ]
        },
        "reviewed_on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "outcomes_seen": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "changed_since_review": {
          "type": "boolean"
        }
      }
    },
    "review_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "phrase"
      ],
      "properties": {
        "kind": {
          "enum": [
            "queue",
            "within_study",
            "flag"
          ]
        },
        "phrase": {
          "type": "string",
          "minLength": 1
        },
        "collection": {
          "type": "string"
        },
        "protocol_id": {
          "type": "string"
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "within_study"
          }
        }
      },
      "then": {
        "required": [
          "kind",
          "phrase",
          "collection",
          "protocol_id"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "collection"
              ]
            },
            {
              "required": [
                "protocol_id"
              ]
            }
          ]
        }
      }
    }
  },
  "properties": {
    "schema_name": {
      "const": "soa2usdm-consistency-queue"
    },
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "check_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "inputs": {
      "type": "object",
      "required": [
        "studies",
        "flags_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "flags_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "studies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "collection",
              "protocol_id",
              "grain_sha256",
              "decisions_sha256",
              "routing_sha256"
            ],
            "properties": {
              "collection": {
                "type": "string"
              },
              "protocol_id": {
                "type": "string"
              },
              "grain_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "decisions_sha256": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "routing_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "review_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "1.1"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "studies",
        "items",
        "phrases_in_two_or_more_studies",
        "items_in_those_phrases",
        "queue_phrases",
        "queue_items",
        "within_study",
        "flags"
      ],
      "properties": {
        "studies": {
          "type": "integer"
        },
        "items": {
          "$ref": "#/definitions/split"
        },
        "phrases_in_two_or_more_studies": {
          "type": "integer"
        },
        "items_in_those_phrases": {
          "$ref": "#/definitions/split"
        },
        "queue_phrases": {
          "type": "integer"
        },
        "queue_items": {
          "$ref": "#/definitions/split"
        },
        "within_study": {
          "type": "integer"
        },
        "flags": {
          "type": "integer"
        },
        "reviewed": {
          "type": "integer",
          "minimum": 0,
          "description": "1.1"
        },
        "changed_since_review": {
          "type": "integer",
          "minimum": 0,
          "description": "1.1"
        },
        "not_reviewed": {
          "type": "integer",
          "minimum": 0,
          "description": "1.1"
        },
        "left_queue_since_review": {
          "type": "integer",
          "minimum": 0,
          "description": "1.1"
        }
      }
    },
    "queue": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/queue_group"
      }
    },
    "within_study": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/within"
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "phrase",
          "studies",
          "note",
          "raised_in",
          "group"
        ],
        "additionalProperties": false,
        "properties": {
          "phrase": {
            "type": "string"
          },
          "studies": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/study"
            }
          },
          "note": {
            "type": "string"
          },
          "raised_in": {
            "type": "string"
          },
          "group": {
            "$ref": "#/definitions/group"
          }
        }
      }
    },
    "left_queue_since_review": {
      "type": "array",
      "description": "1.1: reviewed subjects no longer in the queue, within-study list or flags.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject",
          "result",
          "note",
          "goes_to",
          "reviewed_on",
          "outcomes_seen"
        ],
        "properties": {
          "result": {
            "enum": [
              "accept",
              "knowledge",
              "AI decision to redo",
              "matching fix",
              "routing mechanism",
              "context member list"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "goes_to": {
            "enum": [
              null,
              "step 4",
              "step 5",
              "4d"
            ]
          },
          "reviewed_on": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "outcomes_seen": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "subject": {
            "$ref": "#/definitions/review_subject"
          }
        }
      }
    }
  }
}
