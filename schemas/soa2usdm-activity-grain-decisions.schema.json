{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kerfors.github.io/soa2usdm/schemas/soa2usdm-activity-grain-decisions.json",
  "title": "SoA2USDM Activity Grain Decisions Schema",
  "description": "<id>_activity_grain_decisions.json of a study (SoA2USDM/grain/): hand-kept grain decisions for labels of the study, keyed by phrase. ai_proposed decisions only on labels the rules left unsure; reviewed decisions on any label. Read by soa2usdm.activity_grain, never written by it. The checks the generator makes beyond this schema (phrase in the study, pointer resolves, page in pages_covered, xannot_id exists, context unchanged) are listed in documents/activity-grain.md.",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "protocol_id",
    "protocol_context",
    "decisions"
  ],
  "additionalProperties": false,
  "definitions": {
    "basis": {
      "type": "object",
      "required": [
        "type"
      ],
      "description": "label: the label text; annotation: a footnote or other SoA annotation (xannot_id in the study's consolidated.json); context: an entry of the study's protocol context file (JSON Pointer, e.g. /immunogenicity/3); page: a protocol page inside the context file's pages_covered, when no context entry holds the fact.",
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "label"
            }
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "annotation"
            },
            "xannot_id": {
              "type": "string",
              "pattern": "^xannot-[0-9]+$"
            }
          },
          "required": [
            "xannot_id"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "context"
            },
            "pointer": {
              "type": "string",
              "pattern": "^/.+"
            }
          },
          "required": [
            "pointer"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "page"
            },
            "page": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "page"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "properties": {
    "schema_name": {
      "type": "string",
      "const": "soa2usdm-activity-grain-decisions",
      "description": "Schema identifier."
    },
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ],
      "description": "Schema version."
    },
    "protocol_id": {
      "type": "string",
      "description": "The study (protocol folder name)."
    },
    "protocol_context": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "sha256",
        "prompt_version"
      ],
      "additionalProperties": false,
      "description": "The protocol context file the decisions were checked against; null when the study has none. When the context file changes, the generator stops until this record is updated.",
      "properties": {
        "sha256": {
          "type": "string"
        },
        "prompt_version": {
          "type": "string"
        }
      }
    },
    "decisions": {
      "type": "array",
      "description": "One entry per phrase.",
      "items": {
        "type": "object",
        "required": [
          "phrase",
          "grain",
          "source",
          "rationale",
          "basis",
          "proposed_by",
          "proposed_at"
        ],
        "additionalProperties": false,
        "properties": {
          "phrase": {
            "type": "string",
            "description": "Normalised label (Codelist_Phrases rule), as in the grain file's labels[]."
          },
          "grain": {
            "type": "string",
            "enum": [
              "named test",
              "panel",
              "procedure",
              "instrument",
              "sample collection",
              "other",
              "unsure"
            ]
          },
          "finding_kind": {
            "type": "string",
            "enum": [
              "specimen",
              "immunogenicity",
              "measurement",
              "instrument",
              "pc",
              "genomics",
              "unsure"
            ],
            "description": "Required when grain is named test; absent otherwise."
          },
          "source": {
            "type": "string",
            "enum": [
              "ai_proposed",
              "reviewed"
            ]
          },
          "rationale": {
            "type": "string",
            "description": "One or two sentences."
          },
          "basis": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/basis"
            }
          },
          "proposed_by": {
            "type": "string",
            "description": "Model id or reviewer."
          },
          "proposed_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "if": {
          "properties": {
            "grain": {
              "const": "named test"
            }
          }
        },
        "then": {
          "required": [
            "finding_kind"
          ]
        },
        "else": {
          "not": {
            "required": [
              "finding_kind"
            ]
          }
        }
      }
    }
  }
}
