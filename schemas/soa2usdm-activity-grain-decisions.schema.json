{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kerfors.github.io/soa2usdm/schemas/soa2usdm-activity-grain-decisions.json",
  "title": "SoA2USDM Activity Grain Decisions Schema",
  "description": "<id>_activity_grain_decisions.json of a study (SoA2USDM/grain/): hand-kept grain decisions for labels of the study, keyed by phrase. ai_proposed decisions only on phrases the study's grain inputs file lists (made by prompts/ACTIVITY_GRAIN_DECISIONS_PROMPT.md from that file; schema 1.1); reviewed decisions on any label. Read by soa2usdm.activity_grain, never written by it. The checks the generator makes beyond this schema (phrase in the study, pointer resolves, page in pages_covered, xannot_id exists, context unchanged, grain inputs file current, cdisc rows as published, kind supported by a cdisc entry) are listed in documents/activity-grain.md.",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "protocol_id",
    "protocol_context",
    "decisions"
  ],
  "additionalProperties": false,
  "definitions": {
    "basis": {
      "type": "object",
      "required": [
        "type"
      ],
      "description": "label: the label text; annotation: a footnote or other SoA annotation (xannot_id in the study's consolidated.json); context: an entry of the study's protocol context file (JSON Pointer, e.g. /immunogenicity/3); page: a protocol page inside the context file's pages_covered, when no context entry holds the fact. cdisc (1.1): a row of a public cdisc-for-ai file at the commit the grain file records — Domain_Coverage (domain), SDTM_Test_Identity / SDTM_Instrument_Identity (NCIt code + TESTCD), Codelist_Phrases (codelist + term code).",
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "label"
            }
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "annotation"
            },
            "xannot_id": {
              "type": "string",
              "pattern": "^xannot-[0-9]+$"
            }
          },
          "required": [
            "xannot_id"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "context"
            },
            "pointer": {
              "type": "string",
              "pattern": "^/.+"
            }
          },
          "required": [
            "pointer"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "page"
            },
            "page": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "page"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "cdisc"
            },
            "file": {
              "const": "Domain_Coverage"
            },
            "domain": {
              "type": "string"
            }
          },
          "required": [
            "file",
            "domain"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "cdisc"
            },
            "file": {
              "enum": [
                "SDTM_Test_Identity",
                "SDTM_Instrument_Identity"
              ]
            },
            "code": {
              "type": "string",
              "pattern": "^C[0-9]+$"
            },
            "testcd": {
              "type": "string"
            }
          },
          "required": [
            "file",
            "code",
            "testcd"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "cdisc"
            },
            "file": {
              "const": "Codelist_Phrases"
            },
            "codelist": {
              "type": "string"
            },
            "code": {
              "type": "string",
              "pattern": "^C[0-9]+$"
            }
          },
          "required": [
            "file",
            "codelist",
            "code"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "properties": {
    "schema_name": {
      "type": "string",
      "const": "soa2usdm-activity-grain-decisions",
      "description": "Schema identifier."
    },
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3"
      ],
      "description": "Schema version."
    },
    "protocol_id": {
      "type": "string",
      "description": "The study (protocol folder name)."
    },
    "protocol_context": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "sha256",
        "prompt_version"
      ],
      "additionalProperties": false,
      "description": "The protocol context file the decisions were checked against; null when the study has none. When the context file changes, the generator stops until this record is updated. prompt_version here is the protocol context prompt's version, not the version of the grain decisions prompt (that one is on each ai_proposed decision).",
      "properties": {
        "sha256": {
          "type": "string"
        },
        "prompt_version": {
          "type": "string"
        }
      }
    },
    "decisions": {
      "type": "array",
      "description": "One entry per phrase.",
      "items": {
        "type": "object",
        "required": [
          "phrase",
          "grain",
          "source",
          "rationale",
          "basis",
          "proposed_by",
          "proposed_at"
        ],
        "additionalProperties": false,
        "properties": {
          "phrase": {
            "type": "string",
            "description": "Normalised label (Codelist_Phrases rule), as in the grain file's labels[]."
          },
          "grain": {
            "type": "string",
            "enum": [
              "named test",
              "panel",
              "procedure",
              "instrument",
              "sample collection",
              "other",
              "unsure"
            ]
          },
          "finding_kind": {
            "type": "string",
            "enum": [
              "specimen",
              "immunogenicity",
              "measurement",
              "instrument",
              "pc",
              "genomics",
              "unsure"
            ],
            "description": "Required when grain is named test; absent otherwise."
          },
          "kind_candidates": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "specimen",
                "immunogenicity",
                "measurement",
                "instrument",
                "pc",
                "genomics"
              ]
            },
            "uniqueItems": true,
            "minItems": 2,
            "description": "1.2: with finding_kind unsure only, the two or more kinds the input narrows the row to; each must be given by a cited cdisc entry (checked by the generator)."
          },
          "source": {
            "type": "string",
            "enum": [
              "ai_proposed",
              "reviewed"
            ]
          },
          "rationale": {
            "type": "string",
            "description": "One or two sentences."
          },
          "basis": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/basis"
            }
          },
          "proposed_by": {
            "type": "string",
            "description": "Model id or reviewer."
          },
          "proposed_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "prompt_version": {
            "type": "string",
            "description": "Version of prompts/ACTIVITY_GRAIN_DECISIONS_PROMPT.md that made the decision. Required for ai_proposed (checked by the generator)."
          },
          "inputs_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 of the study's <id>_grain_inputs.json the decision was made from. For ai_proposed in a 1.1 / 1.2 file (checked by the generator when inputs_content_sha256 is absent); kept as a record once inputs_content_sha256 is added."
          },
          "inputs_content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "1.3: the content_sha256 of the study's grain inputs file the decision was made from (its content without the version records). Required for ai_proposed in a 1.3 file; when present, the generator checks it instead of inputs_sha256."
          }
        },
        "if": {
          "properties": {
            "grain": {
              "const": "named test"
            }
          }
        },
        "then": {
          "required": [
            "finding_kind"
          ]
        },
        "else": {
          "not": {
            "required": [
              "finding_kind"
            ]
          }
        }
      }
    }
  }
}
