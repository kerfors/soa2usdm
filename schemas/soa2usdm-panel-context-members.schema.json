{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kerfors.github.io/soa2usdm/schemas/soa2usdm-panel-context-members.json",
  "title": "SoA2USDM panel members from protocol context (per study)",
  "description": "Members of the grain 'panel' rows whose label lists no members, taken from the study's protocol context: SoA panel names linked to context panels by a name rule (D1, no AI), the analytes of the linked context panels as members with the label-member rules (D3), the union by phrase with differences listed (D2), and the context panel's specimen and lab as stated facets (D5). Exists only where protocol context exists; the grain file stays label-only (D4). Generated by soa2usdm.panel_context_members.",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "collection",
    "protocol_id",
    "generated_at",
    "name_rule_version",
    "name_rule",
    "inputs",
    "counts",
    "context_panels",
    "rows"
  ],
  "additionalProperties": false,
  "definitions": {
    "hit": {
      "type": "object",
      "required": [
        "file",
        "sheet",
        "field",
        "source",
        "code",
        "submission_value",
        "as_published"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "enum": [
            "SDTM_Test_Identity",
            "SDTM_Instrument_Identity",
            "Codelist_Phrases"
          ],
          "description": "cdisc-for-ai lookup file."
        },
        "sheet": {
          "type": "string",
          "description": "Sheet of the file."
        },
        "field": {
          "type": "string",
          "description": "Column (or Codelist_Phrases field) the phrase matched."
        },
        "source": {
          "type": "string",
          "enum": [
            "CT",
            "NCIt"
          ],
          "description": "CT: published in SDTM CT; NCIt: NCIt FLAT file synonym."
        },
        "code": {
          "type": "string",
          "description": "NCIt code of the term (for an instrument: of its Test Code codelist)."
        },
        "submission_value": {
          "type": "string",
          "description": "TESTCD, Codelist_TESTCD or term submission value."
        },
        "as_published": {
          "type": "string",
          "description": "The matched string as published."
        },
        "codelist": {
          "type": "string",
          "description": "Codelist_Phrases only: codelist submission value (QSCAT, METHOD, SPECTYPE)."
        },
        "domains": {
          "type": "string",
          "description": "Domains of the test or instrument, as in the lookup ('; '-separated); for a test, the input of rule K1."
        }
      }
    },
    "finding_kind": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "specimen",
        "immunogenicity",
        "measurement",
        "instrument",
        "pc",
        "genomics",
        "unsure",
        null
      ],
      "description": "Kind of finding of a named test: the Domain_Coverage Consumer of its domains (specimen, immunogenicity, measurement, instrument), or pc / genomics for the PC and GF domains; unsure when the domains give no single kind. null when the grain is not named test."
    },
    "peeled": {
      "type": "object",
      "required": [
        "rest",
        "candidate"
      ],
      "additionalProperties": false,
      "description": "1.4, rule L1x: what was peeled off the label and the rest that was looked up as a test.",
      "properties": {
        "rest": {
          "type": "string",
          "description": "The normalised text left after peeling; the test hits are its hits."
        },
        "candidate": {
          "type": "string",
          "enum": [
            "after for",
            "before for",
            "whole"
          ],
          "description": "Which part of the label the rest came from: the text after 'for', before 'for', or the whole text outside brackets."
        },
        "specimen": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "SPECTYPE phrases peeled off."
        },
        "method": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "METHOD phrases peeled off."
        },
        "lab": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Lab words peeled off (PEEL_LAB_WORDS)."
        },
        "condition": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Condition words peeled off (PEEL_CONDITION_WORDS)."
        },
        "activity": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Activity words peeled off (PEEL_ACTIVITY_WORDS)."
        },
        "bracket": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Contents of brackets, set aside."
        },
        "after_for": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "With candidate 'before for': the text after 'for', set aside as a qualifier."
        },
        "kept_in_test_name": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Test names that hold an activity word, kept whole ('pregnancy test')."
        }
      }
    },
    "member": {
      "type": "object",
      "required": [
        "member_id",
        "text",
        "phrase",
        "from",
        "in_group",
        "qualifiers",
        "member_grain",
        "sources",
        "stated_facets"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "description": "Member as split from the analyte."
        },
        "phrase": {
          "type": "string",
          "description": "Normalised member."
        },
        "from": {
          "type": "string",
          "enum": [
            "analyte",
            "analyte list",
            "analyte parenthesis",
            "analyte heading",
            "analyte parenthesis distributed"
          ],
          "description": "analyte: the whole analyte text is the member; analyte list: a top-level member of an analyte that is a list; analyte parenthesis: a member of a group (in_group). 1.1: analyte heading: the text before a colon (A3), its members are in its group; analyte parenthesis distributed: an item of a trailing list parenthesis read with the head's last word ('RBC morphology'), in the head's group (A4)."
        },
        "member_id": {
          "type": "string",
          "pattern": "^c[0-9]{2}$",
          "description": "c01, c02 ... per SoA row, in the order met (context panel, analyte, depth-first); with the row's xact_id it names the member (xact-015.c03)."
        },
        "in_group": {
          "type": [
            "string",
            "null"
          ],
          "description": "member_id of the member whose parenthesis lists this one; null at the top level."
        },
        "qualifiers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "parentheses of the member that are not a list, as stated ('at baseline only', 'for HCC', 'SGOT')."
        },
        "member_grain": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "named test",
            "instrument",
            "panel",
            null
          ],
          "description": "test hit (whole, compact, qualifier dropped, or peeled), instrument hit (L2), a member that names a panel (panel words, MEMBER_PANEL_PHRASES), or null (no hit)."
        },
        "peeled": {
          "$ref": "#/definitions/peeled"
        },
        "finding_kind": {
          "$ref": "#/definitions/finding_kind"
        },
        "kind_rule": {
          "type": "string",
          "enum": [
            "K1"
          ],
          "description": "on a named-test member."
        },
        "kind_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kind_candidates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "review flags of the member (kind)."
        },
        "hits": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/hit"
          },
          "description": "Lookup hits, one per distinct file/code/field."
        },
        "hit_strength": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "strong",
            "weak",
            null
          ],
          "description": "strong: one code, matched on a CT-published field, on the whole phrase, not only through a string of 3 characters or fewer. weak otherwise; null without hits."
        },
        "weak_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Why a hit is weak."
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "description": "D2: every context panel and analyte the member comes from (union by phrase).",
          "items": {
            "type": "object",
            "required": [
              "context_panel",
              "analyte"
            ],
            "additionalProperties": false,
            "properties": {
              "context_panel": {
                "type": "string",
                "pattern": "^/panels/[0-9]+$"
              },
              "analyte": {
                "type": "string"
              }
            }
          }
        },
        "stated_facets": {
          "$ref": "#/definitions/stated_facets"
        }
      }
    },
    "pointer": {
      "type": "string",
      "pattern": "^/panels/[0-9]+$",
      "description": "JSON pointer into the protocol context file."
    },
    "stated_facets": {
      "type": "array",
      "description": "D5: specimen and lab of each source context panel, as stated, with its evidence pages. Not used for routing.",
      "items": {
        "type": "object",
        "required": [
          "facet",
          "value",
          "context_panel",
          "pages"
        ],
        "additionalProperties": false,
        "properties": {
          "facet": {
            "type": "string",
            "enum": [
              "specimen",
              "lab"
            ]
          },
          "value": {
            "type": "string"
          },
          "context_panel": {
            "$ref": "#/definitions/pointer"
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      }
    }
  },
  "properties": {
    "schema_name": {
      "const": "soa2usdm-panel-context-members"
    },
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0",
        "1.1"
      ],
      "description": "1.1 (2026-11-08): analyte_rule_version; 'from' analyte heading and analyte parenthesis distributed."
    },
    "collection": {
      "type": "string"
    },
    "protocol_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "name_rule_version": {
      "type": "string"
    },
    "analyte_rule_version": {
      "type": "string",
      "description": "1.1: version of the analyte rules (A1-A7, soa2usdm.panel_context_members) that read each analyte of a context list."
    },
    "name_rule": {
      "type": "object",
      "required": [
        "spellings",
        "generic_words",
        "lab_codes"
      ],
      "additionalProperties": false,
      "properties": {
        "spellings": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "generic_words": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lab_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "inputs": {
      "type": "object",
      "required": [
        "activity_grain",
        "protocol_context",
        "cdisc_for_ai"
      ],
      "additionalProperties": false,
      "properties": {
        "activity_grain": {
          "type": "object",
          "required": [
            "schema_version",
            "rules_version",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "type": "string"
            },
            "rules_version": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "protocol_context": {
          "type": "object",
          "required": [
            "schema_version",
            "prompt_version",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "type": "string"
            },
            "prompt_version": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "cdisc_for_ai": {
          "type": "object",
          "required": [
            "commit",
            "reference_versions",
            "files"
          ],
          "additionalProperties": false,
          "properties": {
            "commit": {
              "type": "string",
              "description": "git HEAD of the cdisc-for-ai checkout (lookup files clean)."
            },
            "reference_versions": {
              "type": "object",
              "description": "Reference_Versions.json."
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "file",
                  "path",
                  "sheet",
                  "file_sha256",
                  "sheet_content_sha256",
                  "generated",
                  "sdtm_ct",
                  "ncit"
                ],
                "additionalProperties": false,
                "properties": {
                  "file": {
                    "type": "string",
                    "description": ""
                  },
                  "path": {
                    "type": "string",
                    "description": ""
                  },
                  "sheet": {
                    "type": "string",
                    "description": ""
                  },
                  "file_sha256": {
                    "type": "string",
                    "description": ""
                  },
                  "sheet_content_sha256": {
                    "type": "string",
                    "description": ""
                  },
                  "generated": {
                    "type": "string",
                    "description": ""
                  },
                  "sdtm_ct": {
                    "type": "string",
                    "description": ""
                  },
                  "ncit": {
                    "type": "string",
                    "description": ""
                  }
                }
              },
              "description": "Lookup files and their Provenance values."
            }
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "panel_rows",
        "by_link",
        "context_panels",
        "context_panels_used",
        "members",
        "by_member_grain",
        "names_with_several_context_panels"
      ],
      "additionalProperties": false,
      "properties": {
        "panel_rows": {
          "type": "integer",
          "minimum": 0
        },
        "by_link": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "context_panels": {
          "type": "integer",
          "minimum": 0
        },
        "context_panels_used": {
          "type": "integer",
          "minimum": 0
        },
        "members": {
          "type": "integer",
          "minimum": 0
        },
        "by_member_grain": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "names_with_several_context_panels": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "context_panels": {
      "type": "array",
      "description": "The context panels linked to at least one SoA panel name, as the protocol context holds them.",
      "items": {
        "type": "object",
        "required": [
          "pointer",
          "panel_name",
          "specimen",
          "lab",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "pointer": {
            "$ref": "#/definitions/pointer"
          },
          "panel_name": {
            "type": "string"
          },
          "specimen": {
            "type": [
              "string",
              "null"
            ]
          },
          "lab": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "page",
                "quote"
              ],
              "additionalProperties": false,
              "properties": {
                "page": {
                  "type": "integer"
                },
                "quote": {
                  "type": "string"
                },
                "read_from": {
                  "type": "string",
                  "enum": [
                    "text layer",
                    "page image"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "rows": {
      "type": "array",
      "description": "One per grain 'panel' row whose label lists no named-test member.",
      "items": {
        "type": "object",
        "required": [
          "xact_id",
          "activity_name",
          "link",
          "names",
          "members",
          "differences"
        ],
        "additionalProperties": false,
        "properties": {
          "xact_id": {
            "type": "string"
          },
          "activity_name": {
            "type": "string"
          },
          "link": {
            "type": "string",
            "enum": [
              "linked",
              "linked partly",
              "not linked"
            ]
          },
          "names": {
            "type": "array",
            "description": "D1: the whole label, or the panel names of the label, each with the context panels of the same key.",
            "items": {
              "type": "object",
              "required": [
                "name",
                "key",
                "context_panels"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                },
                "context_panels": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/pointer"
                  }
                }
              }
            }
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/member"
            }
          },
          "differences": {
            "type": "array",
            "description": "D2: a name with several context panels: phrases found in only one of them. Flagged, not resolved.",
            "items": {
              "type": "object",
              "required": [
                "name",
                "context_panels",
                "common",
                "only_in"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "context_panels": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/pointer"
                  }
                },
                "common": {
                  "type": "integer",
                  "minimum": 0
                },
                "only_in": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "context_panel",
                      "phrases"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "context_panel": {
                        "$ref": "#/definitions/pointer"
                      },
                      "phrases": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.1"
          }
        }
      },
      "then": {
        "required": [
          "analyte_rule_version"
        ]
      },
      "else": {
        "not": {
          "required": [
            "analyte_rule_version"
          ]
        }
      }
    }
  ]
}
