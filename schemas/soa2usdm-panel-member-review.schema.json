{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kerfors.github.io/soa2usdm/schemas/soa2usdm-panel-member-review.json",
  "title": "SoA2USDM panel member review (kept by hand)",
  "description": "Reading review of the panel members from protocol context (collections/panel_member_review.json, step 3 4d): one entry per reviewed context panel (the AI list read against the protocol pages) or per analyte (the members our code derives from one analyte string of a context list). Results: accept / knowledge (stays open): goes_to null; list defect: the next protocol context prompt revision; derivation fix and matching fix: step 4. Not read by code yet.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "description",
    "reviews"
  ],
  "definitions": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "collection",
        "protocol_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "context panel",
            "analyte"
          ]
        },
        "collection": {
          "type": "string",
          "minLength": 1
        },
        "protocol_id": {
          "type": "string",
          "minLength": 1
        },
        "context_panel": {
          "type": "string",
          "pattern": "^/panels/[0-9]+$"
        },
        "xact_id": {
          "type": "string",
          "pattern": "^xact-[0-9]+$"
        },
        "analyte": {
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "context panel"
          }
        }
      },
      "then": {
        "required": [
          "kind",
          "collection",
          "protocol_id",
          "context_panel"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "xact_id"
              ]
            },
            {
              "required": [
                "analyte"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "kind",
          "collection",
          "protocol_id",
          "context_panel",
          "xact_id",
          "analyte"
        ]
      }
    }
  },
  "properties": {
    "schema_name": {
      "const": "soa2usdm-panel-member-review"
    },
    "schema_version": {
      "const": "1.0"
    },
    "description": {
      "type": "string"
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject",
          "result",
          "defect",
          "effect",
          "note",
          "goes_to",
          "reviewed_on"
        ],
        "properties": {
          "subject": {
            "$ref": "#/definitions/subject"
          },
          "pages_read": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 1
          },
          "result": {
            "enum": [
              "accept",
              "knowledge",
              "list defect",
              "derivation fix",
              "matching fix"
            ]
          },
          "defect": {
            "type": [
              "string",
              "null"
            ]
          },
          "effect": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "goes_to": {
            "type": [
              "string",
              "null"
            ]
          },
          "reviewed_on": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "result": {
                  "enum": [
                    "accept",
                    "knowledge"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "goes_to": {
                  "const": null
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "result": {
                  "const": "list defect"
                }
              }
            },
            "then": {
              "properties": {
                "goes_to": {
                  "const": "context prompt revision"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "result": {
                  "enum": [
                    "derivation fix",
                    "matching fix"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "goes_to": {
                  "const": "step 4"
                }
              }
            }
          }
        ]
      }
    }
  }
}
