{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kerfors.github.io/soa2usdm/schemas/soa2usdm-consistency-review.json",
  "title": "SoA2USDM consistency review (kept by hand)",
  "description": "Review results for the cross-study consistency queue (collections/consistency_review.json): one entry per reviewed queue phrase, within-study entry or flag, with the outcomes seen at review time, the result, a note and where the work goes (accept / knowledge / AI decision to redo: nowhere; matching fix: step 4; routing mechanism: step 5; context member list: 4d). Read by soa2usdm.consistency.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "description",
    "reviews"
  ],
  "definitions": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "phrase"
      ],
      "properties": {
        "kind": {
          "enum": [
            "queue",
            "within_study",
            "flag"
          ]
        },
        "phrase": {
          "type": "string",
          "minLength": 1
        },
        "collection": {
          "type": "string"
        },
        "protocol_id": {
          "type": "string"
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "within_study"
          }
        }
      },
      "then": {
        "required": [
          "kind",
          "phrase",
          "collection",
          "protocol_id"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "collection"
              ]
            },
            {
              "required": [
                "protocol_id"
              ]
            }
          ]
        }
      }
    }
  },
  "properties": {
    "schema_name": {
      "const": "soa2usdm-consistency-review"
    },
    "schema_version": {
      "const": "1.0"
    },
    "description": {
      "type": "string"
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject",
          "outcomes_seen",
          "result",
          "note",
          "goes_to",
          "reviewed_on"
        ],
        "properties": {
          "result": {
            "enum": [
              "accept",
              "knowledge",
              "AI decision to redo",
              "matching fix",
              "routing mechanism",
              "context member list"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "goes_to": {
            "enum": [
              null,
              "step 4",
              "step 5",
              "4d"
            ]
          },
          "reviewed_on": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "outcomes_seen": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "subject": {
            "$ref": "#/definitions/subject"
          }
        }
      }
    }
  }
}
