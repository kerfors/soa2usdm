    }
   ]
  },
  {
   "annotation_marker": "c2",
   "annotation_type": "footnote",
   "annotation_text": "Blood pressure, body temperature, and pulse rate. Vital signs should be measured after participant has been sitting for at least 5minutes.",
   "marker_locations": [
    {
     "table_number": 3,
     "location_type": "activity_name",
     "row_position": 12
    }
   ]
  },
  {
   "annotation_marker": "c3",
   "annotation_type": "footnote",
   "annotation_text": "See Section 8.2.2.",
   "marker_locations": [
    {
     "table_number": 3,
     "location_type": "activity_name",
     "row_position": 13
    }
   ]
  },
  {
   "annotation_marker": "c4",
   "annotation_type": "footnote",
   "annotation_text": "Locally performed.",
   "marker_locations": [
    {
     "table_number": 3,
     "location_type": "activity_name",
     "row_position": 15
    }
   ]
  },
  {
   "annotation_marker": "c5",
   "annotation_type": "footnote",
   "annotation_text": "Check compliance for stool frequency rectal bleeding nocturnal stools bristol stool scale urgency NRS abdominal pain NRS fatigue NRS, and patient global rating of severity ( PGR-s).",
   "marker_locations": [
    {
     "table_number": 3,
     "location_type": "activity_name",
     "row_position": 17
    }
   ]
  },
  {
   "annotation_marker": "c6",
   "annotation_type": "footnote",
   "annotation_text": "Fasting samples are preferred, but if participant is nonfasting at time of collection, this is not a protocol deviation.",
   "marker_locations": [
    {
     "table_number": 3,
     "location_type": "activity_name",
     "row_position": 25
    }
   ]
  },
  {
   "annotation_marker": "c7",
   "annotation_type": "footnote",
   "annotation_text": "Perform only for women of childbearing potential and women with a history of tubal ligation. At dosing visits which have pregnancy testing, the pregnancy test result must be confirmed to be negative prior to dosing. Pregnancy testing maybe performed more frequently than designated on the SoA if local laws or regulations require more frequent testing.",
   "marker_locations": [
    {
     "table_number": 3,
     "location_type": "activity_name",
     "row_position": 27
    }
   ]
  },
  {
   "annotation_marker": "c8",
   "annotation_type": "footnote",
   "annotation_text": "Only for participants who are positive for anti‑HBc at screening.",
   "marker_locations": [
    {
     "table_number": 3,
     "location_type": "activity_name",
     "row_position": 29
    }
   ]
  },
  {
   "annotation_marker": "c9",
   "annotation_type": "footnote",
   "annotation_text": "Collect samples before dosing, if dosing is scheduled. Collect additional samples at specified times relative to onset of hypersensitivity events.",
   "marker_locations": [
    {
     "table_number": 3,
     "location_type": "activity_name",
     "row_position": 30
    }
   ]
  },
  {
   "annotation_marker": "c9_2",
   "annotation_type": "footnote",
   "annotation_text": "Collect samples before dosing, if dosing is scheduled. Collect additional samples at specified times relative to onset of hypersensitivity events.",
   "marker_locations": [
    {
     "table_number": 3,
     "location_type": "activity_name",
     "row_position": 31
    }
   ]
  },
  {
   "annotation_marker": "c10",
   "annotation_type": "footnote",
   "annotation_text": "Blood sample for DNA pharmacogenetics can be obtained any time at or after V2.",
   "marker_locations": [
    {
     "table_number": 3,
     "location_type": "activity_name",
     "row_position": 33
    }
   ]
  },
  {
   "annotation_marker": "c11",
   "annotation_type": "footnote",
   "annotation_text": "Performed at time of endoscopy. Instructions for collection are provided in the lab manual. Flexible sigmoidoscopy is recommended, except for protocol-specified reasons when a colonoscopy should be performed.",
   "marker_locations": [
    {
     "table_number": 3,
     "location_type": "activity_name",
     "row_position": 36
    }
   ]
  },
  {
   "annotation_marker": "c12",
   "annotation_type": "footnote",
   "annotation_text": "No dosing at V29.",
